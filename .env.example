# ==========================================
# BASE DE DONNÉES & SÉCURITÉ
# ==========================================
# Chaîne de connexion PostgreSQL (ex: Supabase Transaction Pooler sur le port 6543 avec pgbouncer=true)
DATABASE_URL="postgresql://postgres.votre_projet_id:votre_mot_de_passe@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe pour les migrations Prisma (Session Pooler sur le port 5432)
DIRECT_URL="postgresql://postgres.votre_projet_id:votre_mot_de_passe@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Clé secrète de chiffrement des tokens JWT de session (minimum 16 caractères cryptographiquement sûrs)
JWT_SECRET="votre_cle_secrete_jwt_robuste_production_ready_2024"

# ==========================================
# CONFIGURATION DE LA BOUTIQUE
# ==========================================
NEXT_PUBLIC_STORE_NAME="Butiky"
NEXT_PUBLIC_STORE_LEGAL_NAME="2KR DIGITAL"
NEXT_PUBLIC_STORE_SLOGAN="Smartphones Neufs & Accessoires Authentiques au Bénin"
NEXT_PUBLIC_STORE_PHONE="+229 97 00 00 00"
NEXT_PUBLIC_STORE_WHATSAPP="+229 97 00 00 00"
NEXT_PUBLIC_STORE_EMAIL="contact@butiky.bj"
NEXT_PUBLIC_STORE_ADDRESS="Cadjehoun, Cotonou, Bénin"
NEXT_PUBLIC_STORE_CITY="Cotonou"
NEXT_PUBLIC_STORE_COUNTRY="Bénin"
NEXT_PUBLIC_STORE_OPENING_HOURS="Lun - Sam : 08h30 - 19h30"
NEXT_PUBLIC_STORE_CURRENCY="FCFA"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# AUTHENTIFICATION GOOGLE OAUTH 2.0 (Optionnel)
# ==========================================
GOOGLE_CLIENT_ID="votre_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="votre_google_client_secret"

# ==========================================
# PASSERELLE DE PAIEMENT : KKIAPAY
# https://docs.kkiapay.me/v1
# ==========================================
# Clé Publique (utilisée par le widget frontend Kkiapay)
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY="votre_cle_publique_kkiapay"

# Clé Privée (utilisée côté serveur pour vérifier les paiements)
KKIAPAY_PRIVATE_KEY="pk_votre_cle_privee_kkiapay"

# Clé Secrète / Secret Webhook Kkiapay
KKIAPAY_SECRET="sk_votre_secret_webhook_kkiapay"

# Mode Sandbox : "true" pour les tests, "false" pour la production
NEXT_PUBLIC_KKIAPAY_SANDBOX="false"

# ==========================================
# PASSERELLE DE PAIEMENT : FEDAPAY
# https://docs.fedapay.com
# ==========================================
# Clé Publique (utilisée par le bouton / checkout FedaPay)
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY="pk_live_votre_cle_publique_fedapay"

# Clé Secrète (utilisée côté serveur pour créer et vérifier les transactions)
FEDAPAY_SECRET_KEY="sk_live_votre_cle_secrete_fedapay"

# Environnement FedaPay : "sandbox" pour les tests, "live" pour la production
NEXT_PUBLIC_FEDAPAY_ENVIRONMENT="live"

# ==========================================
# SERVICE D'EMAIL TRANSACTIONNEL : RESEND
# Obtenez votre clé sur https://resend.com/api-keys
# ==========================================
# Clé API Resend (ex: re_123456789...)
RESEND_API_KEY="re_votre_cle_api_resend"

# Expéditeur des emails transactionnels (par défaut onboarding@resend.dev en test, ou votre domaine vérifié)
RESEND_FROM_EMAIL="Butiky <onboarding@resend.dev>"

# ==========================================
# STOCKAGE D'IMAGES CLOUDFLARE R2 / AWS S3 (Optionnel en local)
# Obtenez vos clés sur https://dash.cloudflare.com/?to=/:account/r2
# ==========================================
R2_ACCOUNT_ID="votre_cloudflare_account_id"
R2_ACCESS_KEY_ID="votre_r2_access_key_id"
R2_SECRET_ACCESS_KEY="votre_r2_secret_access_key"
R2_BUCKET_NAME="butiky-uploads"
R2_PUBLIC_DOMAIN="https://pub-votre_id.r2.dev"

# ==========================================
# RATE LIMITING DISTRIBUÉ (UPSTASH REDIS) - Optionnel
# https://upstash.com
# ==========================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
